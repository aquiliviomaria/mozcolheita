# Godot: caches e ficheiros regenerados localmente
.godot/
.mono/
/android/

# Exportações e compilações locais
/build/
/dist/
/export/
/exports/
**/exported/
.export-to-txt.*

# Gravações locais e resultados de execução/testes
*.mozsave
*.mozsave.*
*.log
*.tmp
*.temp

# Cópia antiga do projecto e ferramentas locais
/.mozcolheita-anterior/
/.kombai/

# Sistema operativo e ficheiros temporários dos editores
.DS_Store
Thumbs.db
desktop.ini
*.lnk
*.swp
*.swo
*~

# Configuração privada local; exemplos podem ser partilhados
.env
.env.*
!.env.example

# Addons: conservar código/configuração; excluir binários e builds locais
addons/**/*.dll
addons/**/*.so
addons/**/*.dylib
addons/**/*.a
addons/**/*.lib
addons/**/*.pdb
addons/**/*.obj
addons/**/*.o
addons/**/*.exe
addons/**/*.bin
addons/**/*.bc
addons/**/*.zip
addons/**/*.7z
addons/**/android/
addons/**/ios/
addons/**/linux/
addons/**/macos/
addons/**/windows/
addons/**/native/
addons/**/build/
addons/**/bin/
addons/**/.build/

# Os assets originais, *.uid, *.import, testes e capturas de documentação
# fazem parte do projecto e devem poder ser versionados.
